#!/usr/bin/env wap
# The simplest sort there is (Fung 2021): for every pair of places i, j, swap their items when A[i] < A[j]
#   for i = 1 to n do
#       for j = 1 to n do
#           if A[i] < A[j] then
#               swap A[i] and A[j]
A = [32, 234, 3, 2, 4, 532, 23, 1, 3]
for i in 0 upto #A {
	for j in 0 upto #A {
		if A[i] < A[j] { A[i], A[j] = A[j], A[i] }
	}
}
A
