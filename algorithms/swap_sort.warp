#!/usr/bin/env warp
# for i = 1 to n do
#     for j = 1 to n do
#         if A[i] < A[j] then
#             swap A[i] and A[j]

swap(xs, i, j) := {
    t = xs#i
    xs#i = xs#j
    xs#j = t
}

A = [32, 234, 3, 2, 4, 532, 23, 1, 3]
n = count(A)
for i in 1 to n do
    for j in 1 to n do
        if A#i < A#j then
            swap A i j
A
