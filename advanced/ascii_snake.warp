#!/usr/bin/env wap
# Snake, playing itself: the snake steers toward the food, never into a wall or itself while another way is free;
# each turn a frame, drawn in place
use terminal
use units

WIDTH := 20
HEIGHT := 15
TURNS := 60
FOOD_SCORE := 10

class Spot { x: int, y: int }
+(a: Spot, b: Spot): Spot := Spot(a.x + b.x, a.y + b.y)
==(a: Spot, b: Spot): bool := a.x == b.x and a.y == b.y
RIGHT := Spot(1, 0)
LEFT := Spot(-1, 0)
DOWN := Spot(0, 1)
UP := Spot(0, -1)

global snake = [Spot(10, 7), Spot(9, 7), Spot(8, 7)]
global direction = RIGHT
global food = Spot(15, 7)
global score = 0
global game_over = no
global foods_eaten = 0

# the next food: a fixed walk over the board, so every game is the same
spawn_food(): Spot := {
	for attempt in 1 to WIDTH * HEIGHT {
		spot = Spot((foods_eaten * 7 + attempt * 3) % WIDTH, (foods_eaten * 5 + attempt * 11) % HEIGHT)
		if not snake.contains(spot) { return spot }
	}
	Spot(0, 0)
}

is_free(spot: Spot): bool := spot.x >= 0 and spot.x < WIDTH and spot.y >= 0 and spot.y < HEIGHT and not snake.contains(spot)

# turn toward the food, never into a wall or itself when another way is free
steer() := {
	head = snake[0]
	wanted = if food.x > head.x then RIGHT else if food.x < head.x then LEFT else if food.y > head.y then DOWN else if food.y < head.y then UP else direction
	free = [wanted, direction, DOWN, UP, RIGHT, LEFT].filter(way => is_free(head + way))
	if free { direction = free[0] }
}

update() := {
	next = snake[0] + direction
	if not is_free(next) {
		game_over = yes
		return
	}
	snake = [next] + snake
	if next == food {
		score += FOOD_SCORE
		foods_eaten += 1
		food = spawn_food()
	} else {
		snake.pop()
	}
}

cell(spot: Spot): text := if spot == snake[0] then "@" else if snake.contains(spot) then "o" else if spot == food then "*" else "."

render() := {
	for y in 0 upto HEIGHT { print (0 upto WIDTH).map(x => cell(Spot(x, y))).join("") }
	print "Score: ${score}"
}

for turn in 1 to TURNS {
	if not game_over {
		steer()
		update()
	}
	clear_screen()
	render()
	sleep(50ms)
}
if game_over { print "GAME OVER" }
score
