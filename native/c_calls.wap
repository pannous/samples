#!/usr/bin/env warp
@primitive
# host: native: C calls need the native warp
# C functions of lib/c.warp and lib/math.warp: `GREETING=Hi warp c_calls.wap`, or natively
# `warp build native c_calls.wap`, then `GREETING=Hi ./c_calls`
import (getenv, strlen) from "c"
import hypot from "m"
greeting = getenv("GREETING")
print greeting
print text_of(strlen(greeting))
print text_of(hypot(3.0, 4.0) as i64)
