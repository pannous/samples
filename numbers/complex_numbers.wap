#!/usr/bin/env wap
# Complex numbers (lib/complex.wap, wiki/library-complex.md): ⅈ is the imaginary unit, √-1, so 3 + 4ⅈ is a complex
# number, and plain numbers mix with complex ones on either side of + - * /
use complex
z = 3 + 4ⅈ
w = 1 + 2ⅈ
print "z + w = ${z + w}"
print "z * w = ${z * w}"
print "z / w = ${z / w}"
print "1 - z = ${1 - z}"
print "|z| = ${abs(z)}"
print "ⅈ² = ${ⅈ ^ 2}"
print "√-4 = ${complex_sqrt(-4)}"
# Euler's identity: e^(ⅈπ) = -1, up to the last digit of a float
complex_near(complex_exp(ⅈ * π), -1, 1e-9)
