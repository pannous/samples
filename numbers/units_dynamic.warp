#!/usr/bin/env wap
# Units known only at run time: quantity("5 km") reads a quantity from text, quantity(5, unit) takes a unit given as
# data. Each carries its unit with it, as a unit written in the program does (`5km`, lib/units.wap)
use units
legs = ["5 km", "250m", "1.5 km", "800 m"]
total = legs.map(leg => quantity(leg)).fold(quantity(0, "km"), (sum, leg) => sum + leg)
print "run: ${total}, in metres ${total in "m"}"

speed = total / quantity("45 min")
print "pace: about ${round((speed in "km/h") * 10) / 10} km/h"

unit = "kg"
print quantity(3, unit) > quantity("2500 g")
print try text(total + quantity("45 min")) else "distance and time do not add"
