#!/usr/bin/env wap
# Which shops are open at a fixed reference instant: opening windows are times since midnight (9h, 17h), compared
# with the instant's time of day (time, units, tables)
use time
use units
use tables

class Shop { name: text, open: Quantity, close: Quantity }
reference = "2026-11-05T14:00:00Z" as Instant
clock = quantity(day_time(reference))
shops = [Shop("Bakery", 6h, 13h), Shop("Post office", 9h, 17h), Shop("Supermarket", 8h, 22h), Shop("Night club", 22h, 24h)]

is_open(shop: Shop): bool := clock >= shop.open and clock < shop.close
rows = shops.map(shop => [shop.name, "${shop.open} - ${shop.close}", if is_open(shop) then "open" else "closed"])
print "as of ${reference} (${clock.to(h)} since midnight): ${#shops.filter(is_open)} of ${#shops} shops open"
print ""
print table_text(rows, headers: ["shop", "hours", "status"])
