#!/usr/bin/env wap
# A todo list on the command line, kept as JSON in a file (json, file, cli)
#   wap samples/apps/todo_cli.warp add "buy milk"   |   done 1   |   list   |   clear   |   --file todos.json list
# without arguments it plays a short session in a fresh file of the temp folder
use json
use file
use cli

# git style: global options, then a command with its own
options = [{name: "file", short: "f", help: "the JSON file of the todos (else wap_todo_demo.json in the temp folder)"}]
commands = {
	add: {help: "add a todo", options: [{name: "title", positional: yes, many: yes}]},
	done: {help: "mark a todo done", options: [{name: "id", kind: "int", positional: yes}]},
	list: {help: "show the todos"},
	clear: {help: "remove every todo"}
}
# a mistake on the command line is shown with the help, never a trace
parsed(argv: list<text>): map<text, any> := try { parse_commands(options, commands, argv) } catch e {
	print e.message
	{help: yes, command: ø}
}

given: map<text, any> = if args then parsed(args) else {help: no, command: ø}
store: text = given.get("file") ?? temp_folder() + "/wap_todo_demo.json"

# the todos stored, each a map of JSON
load(): list<map<text, any>> := if exists(store) then (parse_json(read(store)) as list<any>).map(item => item as map<text, any>) else []
keep(items: list<map<text, any>>) := write(store, to_json(items))
next_id(items: list<map<text, any>>): int := if items is empty then 1 else items.map(item => item.id as int).max() + 1

add(title: text) := {
	items = load()
	item: map<text, any> = {id: next_id(items), title: title, done: no}
	keep(items + [item])
	print "added #${item.id}: ${title}"
}
finish(id: int) := {
	items = load()
	found = items.filter(item => item.id == id)
	for item in found { item.done = yes }
	if found {
		keep(items)
		print "done #${id}"
	} else {
		print "no todo #${id}"
	}
}
show() := {
	items = load()
	for item in items { print "${if item.done == yes then "[x]" else "[ ]"} ${item.id}. ${item.title}" }
	open = #items.filter(item => item.done == no)
	print if items is empty then "nothing to do" else "${open} open, ${#items - open} done"
}
run(o: map<text, any>) := {
	verb = o["command"]
	if verb == "add" then add(o["title"].join(" "))
	else if verb == "done" then finish(o["id"])
	else if verb == "list" then show()
	else {
		keep([])
		print "cleared"
	}
}
# one parsed command line: the help, or the command it names
act(o: map<text, any>) := {
	if o["help"] == no then run(o)
	else if o["command"] == ø then print cli_commands_help("todo", options, commands)
	else print cli_command_text("todo", commands, o["command"])
}

if args {
	act(given)
} else {
	keep([])
	for argv in [["list"], ["add", "buy", "milk"], ["add", "write", "the", "report"], ["add", "call", "Ada"], ["done", "2"], ["done", "7"], ["list"], ["frobnicate"], ["--color", "list"], ["done", "two"], ["add", "--help"], ["--help"]] {
		print "$ todo ${argv.join(" ")}"
		act(parsed(argv))
	}
	print "stored: ${read(store)}"
	print "demo file removed: ${delete_file(store)}"
}
