#!/usr/bin/env warp
# Named deadlines checked against a fixed reference instant: overdue, due soon (within 2 days) or later,
# with the time remaining, as a table (time, tables)
use time
use tables

today = Instant("2026-11-05T12:00:00Z")
soon = Duration("2d")
class Deadline { name: text, due: Instant }
deadlines = [
	Deadline("Tax return", Instant("2026-10-31")),
	Deadline("Conference talk", Instant("2026-11-06T09:30:00Z")),
	Deadline("Rent", Instant("2026-11-07")),
	Deadline("Passport renewal", Instant("2026-12-01")),
	Deadline("Invoice #42", Instant("2026-11-04T17:00:00Z")),
	Deadline("Car service", Instant("2027-01-15"))]

state(left: Duration): text := if left < Duration(0) then "overdue" else if left <= soon then "due soon" else "later"
remaining(left: Duration): text := if left < Duration(0) then "${abs(left)} ago" else "${left}"
rows = deadlines.map(d => [d.name, date(d.due), state(d.due - today), remaining(d.due - today), "${days(d.due - today)}"])
late = deadlines.filter(d => d.due < today)
print("as of ${date(today)}: ${#deadlines} deadlines, ${#late} overdue")
print("")
print(table_text(rows, headers: ["deadline", "due", "status", "remaining", "days"]))
