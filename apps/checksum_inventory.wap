#!/usr/bin/env wap
# A checksum manifest of a few files, then a verify pass that names what changed (file, hash, json)
#   sha256 for each file's content, crc32 as a quick second check, the manifest kept as JSON beside them
# it plays the whole story in fresh files of the temp folder
use file
use hash
use json

folder = temp_folder()
path_of(name: text): text := "${folder}/wap_inventory_${name}"
manifest_path = path_of("manifest.json")

files = {
	"readme.txt": "wap checksums\n",
	"notes.txt": "buy milk\ncall Ada\n",
	"data.csv": "id,qty\n1,4\n2,9\n"
}
names = files.keys()
for name in names { write(path_of(name), files[name]) }

# one manifest entry: the size in bytes, its sha256 and crc32
entry(content: text): map<text, any> := {size: #content.bytes, sha256: sha256(content), crc32: crc32(content)}
short(digest: text): text := digest[0:12]

# the manifest of the names that exist now
manifest(wanted: list<text>): map<text, map<text, any>> := {
	m: map<text, map<text, any>> = {}
	for name in wanted.filter(name => exists(path_of(name))) { m[name] = entry(read(path_of(name))) }
	m
}

made = manifest(names)
write(manifest_path, to_json(made))
print "manifest of ${#made.keys()} files:"
for name in made.keys() {
	e = made[name]
	print "  ${name}  ${e.size} bytes  sha256 ${short(e.sha256)}…  crc32 ${e.crc32}"
}
print "empty text sha256: ${sha256("")}"
print "same content, same digest: ${sha256("buy milk\ncall Ada\n") == made["notes.txt"].sha256}"

# one name of the saved manifest checked against the file on disk
status(name: text, saved: map<text, any>): text := {
	if not exists(path_of(name)) { return "missing  ${name}" }
	now = entry(read(path_of(name)))
	if now.sha256 == saved.sha256 then "ok       ${name}" else "changed  ${name} (${saved.size} -> ${now.size} bytes)"
}
# the verify pass: each saved name's status, then the files present that the manifest lacks
verify(saved: map<text, any>, present: list<text>): list<text> := {
	known = saved.keys().map(name => status(name, saved[name]))
	added = present.filter(name => not saved.has(name) and exists(path_of(name))).map(name => "new      ${name}")
	known + added
}

print "$ verify (untouched)"
for line in verify(parse_json(read(manifest_path)), names) { print line }

write(path_of("notes.txt"), "buy milk\ncall Ada\nwrite report\n")
delete_file(path_of("data.csv"))
write(path_of("todo.txt"), "ship it\n")
print "$ verify (notes edited, data.csv deleted, todo.txt added)"
for line in verify(parse_json(read(manifest_path)), names + ["todo.txt"]) { print line }

cleaned = ["readme.txt", "notes.txt", "todo.txt", "manifest.json"].map(name => delete_file(path_of(name)))
print "demo files removed: ${cleaned.all(done => done)}"
