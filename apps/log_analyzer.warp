#!/usr/bin/env warp
# An access-log analyzer: regex pulls the fields, list statistics sum them up, tables print the report (regex, list, tables)
use regex
use list
use math
use tables

log = "192.168.1.10 - - [05/Nov/2026:09:14:02 +0100] \"GET /index.html HTTP/1.1\" 200 5120 0.012
192.168.1.11 - - [05/Nov/2026:09:14:05 +0100] \"GET /about.html HTTP/1.1\" 200 2048 0.008
10.0.0.7 - - [05/Nov/2026:09:15:11 +0100] \"POST /api/login HTTP/1.1\" 401 312 0.120
192.168.1.10 - - [05/Nov/2026:09:15:40 +0100] \"GET /missing.png HTTP/1.1\" 404 0 0.002
10.0.0.7 - - [05/Nov/2026:09:16:02 +0100] \"POST /api/login HTTP/1.1\" 200 845 0.095
192.168.1.12 - - [05/Nov/2026:09:17:30 +0100] \"GET /index.html HTTP/1.1\" 200 5120 0.010
10.0.0.9 - - [05/Nov/2026:09:18:44 +0100] \"GET /api/report HTTP/1.1\" 500 128 1.502
192.168.1.11 - - [05/Nov/2026:09:19:01 +0100] \"GET /index.html HTTP/1.1\" 304 0 0.004
this line is garbage and gets skipped"

# one request per line: ip, time, method, path, status, bytes, seconds; ø for a line that is no request
LINE = "^([0-9.]+) [^[]*\\[([^]]+)\\] \"([A-Z]+) ([^ ]+) [^\"]*\" ([0-9]{3}) ([0-9]+) ([0-9.]+)$"
class Request { ip: text, time: text, method: text, path: text, status: int, bytes: int, seconds: float }
request_of(line: text): Request? := {
	g = match_groups(line, LINE) ?? return ø
	Request(g[0], g[1], g[2], g[3], int(g[4]), int(g[5]), float(g[6]))
}
lines = log.split("\n")
requests = lines.map(request_of).compact
print("parsed ${#requests} of ${#lines} lines")

# hits, bytes and errors per path, the busiest first
row_of(path: text): list<any> := {
	hits = requests.filter(r => r.path == path)
	[path, #hits, hits.map(r => r.bytes).sum, #hits.filter(r => r.status >= 400)]
}
rows = unique(requests.map(r => r.path)).map(row_of).sorted(by: row => -(row[1] as int))
print(table_text(rows, headers: ["path", "hits", "bytes", "errors"]))

# status classes and latency
print("status codes: ${tally(requests.map(r => r.status))}")
times = requests.map(r => r.seconds)
print("latency mean ${round_to(mean(times), 3)} s, median ${round_to(median(times), 3)} s, p90 ${round_to(percentile(times, 90.0), 3)} s")
slowest = requests.sorted(by: r => -r.seconds)[0]
print("slowest: ${slowest.method} ${slowest.path} (${slowest.seconds} s, status ${slowest.status})")
print("busiest client: ${frequencies(requests.map(r => r.ip)).sorted(by: f => -(f[1] as int))[0][0]}")

# requests per minute: the hour and minute out of each time stamp, as a bar per minute
per_minute = tally(requests.map(r => (match_groups(r.time, ":([0-9]{2}):([0-9]{2}):") ?? []).join(":")))
for minute in keys(per_minute).sorted { print("${minute} ${"#" * per_minute[minute]}") }

# the clients that got an error answer
print("clients with errors: ${unique(requests.filter(r => r.status >= 400).map(r => r.ip)).join(", ")}")
