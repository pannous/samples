#!/usr/bin/env warp
# The free slots of a 9:00-17:00 workday between meetings, at least 30 minutes each (intervals, time durations)
use intervals
use time
# times of day as minutes since midnight, the intervals' numbers
at(h: int, m: int): float := float(h * 60 + m)
MINUTE := Duration("1m")
clock(minutes: float): text := time(Instant(0) + MINUTE * int(minutes))[0:5]
day = extent(at(9, 0), at(17, 0))
meetings = [extent(at(13, 0), at(14, 0)), extent(at(9, 30), at(10, 15)), extent(at(10, 0), at(11, 0)), extent(at(16, 40), at(17, 0))]
slots = subtract_intervals(day, meetings).filter(e => extent_length(e) >= 30)
print(slots.map(e => "${clock(e.lo)}-${clock(e.hi)} (${format(MINUTE * int(extent_length(e)), long: yes)})").join("\n"))
