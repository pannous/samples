#!/usr/bin/env wap
# Sudoku Solver
# Backtracking algorithm
# the grid is a flat list of 81 cells, row by row; each try fills a copy and solve returns the solved grid (or [] if
# none)

parse_grid(s: text): list<int> := s.replace(".", "0").codepoints.map(c => int("${c}"))

cell(grid: list<int>, x: int, y: int): int := grid[y * 9 + x]

is_valid(grid: list<int>, row: int, col: int, num: int): bool := {
	box_x = col ÷ 3 * 3
	box_y = row ÷ 3 * 3
	in_lines = (0 upto 9).any(i => cell(grid, i, row) == num or cell(grid, col, i) == num)
	in_box = (0 upto 9).any(i => cell(grid, box_x + i % 3, box_y + i ÷ 3) == num)
	not in_lines and not in_box
}

solve(grid: list<int>): list<int> := {
	open = (0 upto 81).filter(i => grid[i] == 0)
	if open is empty { return grid }
	i = open[0]
	for num in 1 upto 10 {
		if is_valid(grid, i ÷ 9, i % 9, num) {
			candidate = grid.copy()
			candidate[i] = num
			solved = solve(candidate)
			if solved { return solved }
		}
	}
	[]
}

print_grid(grid: list<int>) := {
	for y in 0 upto 9 {
		if y % 3 == 0 and y > 0 { print "------+-------+------" }
		cells = (0 upto 9).map(x => (if x % 3 == 0 and x > 0 then "| " else "") + (if cell(grid, x, y) == 0 then "." else "${cell(grid, x, y)}"))
		print cells.join(" ") + " "
	}
}

# Example puzzle (. = empty)
puzzle = "53..7....6..195....98....6.8...6...34..8.3..17...2...6.6....28....419..5....8..79"

grid = parse_grid(puzzle)
print "Puzzle:"
print_grid(grid)
print ""

solution = solve(grid)
if solution {
	print "Solution:"
	print_grid(solution)
} else {
	print "No solution exists"
}
solution[0] * 100 + solution[1] * 10 + solution[2]
